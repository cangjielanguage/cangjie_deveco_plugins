{
  "name": "@ohos/cangjie-build-support",
  "version": "5.1.3",
  "description": "cangjie build plugin.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepack": "npm run ugly-build",
    "uglify": "node scripts/uglify.js",
    "ugly-build": "npm run clean && npm run build && npm run uglify",
    "patch-publish": "npm --no-git-tag-version version prepatch&&npm publish",
    "clean": "tsc --build --clean",
    "rebuild": "npm run clean && npm run build",
    "test": "jest",
    "coverage": "nyc --clean jest --coverage",
    "postinstall": "patch-package"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "author": "huawei",
  "ohos": {
    "org": "huawei"
  },
  "engines": {
    "node": ">14.14.0"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "commonjs",
  "nyc": {
    "reporter": ["lcov", "text"],
    "tempDirectory": "./coverage"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@ohos/hvigor": "6.23.4-rc.11",
    "@ohos/hvigor-ohos-plugin": "6.23.4-rc.11",
    "@types/lodash": "^4.14.178",
    "@types/node": "^16.11.10",
    "@typescript-eslint/eslint-plugin": "5.59.11",
    "@typescript-eslint/parser": "5.59.11",
    "eslint": "^8.21.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "terser": "^5.12.1",
    "typescript": "4.7.4"
  },
  "keywords": [
    "hvigor",
    "OpenHarmony"
  ]
}

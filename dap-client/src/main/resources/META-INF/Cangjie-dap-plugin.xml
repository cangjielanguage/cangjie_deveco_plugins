    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <extensions defaultExtensionNs="com.intellij">
        <xdebugger.breakpointType
                implementation="com.huawei.cangjie.debugger.breakpoint.type.CangjieSourceBreakpointType"/>
        <xdebugger.breakpointType
                implementation="com.huawei.cangjie.debugger.breakpoint.type.CangjieFunctionBreakpointType"/>
        <xdebugger.breakpointType
                implementation="com.huawei.cangjie.debugger.breakpoint.type.CangjieDataBreakpointType"/>
        <xdebugger.breakpointType implementation="com.huawei.cangjie.debugger.breakpoint.type.CangjieInstructionBreakpointType"/>
        <fileType name="CangjieLldbApiFileTypeCommands" language="LLDB_CANGJIE"
                  implementationClass="com.huawei.cangjie.debugger.console.editor.CangjieLldbLanguageFileType" fieldName="INSTANCE"
                  extensions="CangjieLldbApiFileTypeExtension" />
        <langCodeStyleSettingsProvider
                implementation="com.huawei.cangjie.debugger.console.editor.CangjieLldbLanguageCodeStyleProvider"/>
        <postStartupActivity implementation="com.huawei.cangjie.debugger.register.CangjieStartupActivity"/>
        <projectConfigurable parentId="project.propDebugger"
                             instance="com.huawei.cangjie.debugger.settings.CangjieSettingPanel"
                             id="com.huawei.cangjie.debugger.settings.CangjieSettingPanel"
                             displayName="Cangjie Debugger"/>
    </extensions>
    <extensions defaultExtensionNs="com.huawei.ohos">
        <harmonyDebugger implementation="com.huawei.cangjie.debugger.ohos.CangjieOpenHarmonyDebugger"/>
        <harmonyDebugger implementation="com.huawei.cangjie.debugger.ohos.CangjieDualOpenHarmonyDebugger"/>
    </extensions>
    <actions>
        <action id="com.huawei.cangjie.debugger.action.databp.CangjieSetNoTypeDataBreakpointAction"
                class="com.huawei.cangjie.debugger.action.databp.CangjieSetNoTypeDataBreakpointAction"
                text="Break on Value Access">
            <add-to-group group-id="XDebugger.ValueGroup"
                          relative-to-action="XDebugger.JumpToTypeSource" anchor="after"/>
        </action>
        <action id="com.huawei.cangjie.debugger.action.databp.CangjieSetReadDataBreakpointAction"
                class="com.huawei.cangjie.debugger.action.databp.CangjieSetReadDataBreakpointAction"
                text="Break on Value Read">
            <add-to-group group-id="XDebugger.ValueGroup"
                          relative-to-action="com.huawei.cangjie.debugger.action.databp.CangjieSetNoTypeDataBreakpointAction"
                          anchor="after"/>
        </action>
        <action id="com.huawei.cangjie.debugger.action.databp.CangjieSetWriteDataBreakpointAction"
                class="com.huawei.cangjie.debugger.action.databp.CangjieSetWriteDataBreakpointAction"
                text="Break on Value Change">
            <add-to-group group-id="XDebugger.ValueGroup"
                          relative-to-action="com.huawei.cangjie.debugger.action.databp.CangjieSetReadDataBreakpointAction"
                          anchor="after"/>
        </action>
        <action id="com.huawei.cangjie.debugger.action.databp.CangjieSetReadWriteDataBreakpointAction"
                class="com.huawei.cangjie.debugger.action.databp.CangjieSetReadWriteDataBreakpointAction"
                text="Break on Value Access">
            <add-to-group group-id="XDebugger.ValueGroup"
                          relative-to-action="com.huawei.cangjie.debugger.action.databp.CangjieSetWriteDataBreakpointAction"
                          anchor="after"/>
        </action>
    </actions>
</idea-plugin>

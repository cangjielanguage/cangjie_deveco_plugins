<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.huawei.ideacj.actions.CangjieFileDialog">
  <grid id="27dc6" binding="myPanel" default-binding="true" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="75ead" class="javax.swing.JTextField" binding="fileNameField" default-binding="true">
        <constraints>
          <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="bbbb0" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="File name"/>
        </properties>
      </component>
      <component id="5203e" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Type"/>
        </properties>
      </component>
      <component id="d2daa" class="javax.swing.JComboBox" binding="fileTypeBox" default-binding="true">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value=".cj"/>
          </model>
        </properties>
      </component>
    </children>
  </grid>
</form>

    <depends optional="true" config-file="cj-copyright.xml">com.intellij.copyright</depends>
    <xi:include href="/META-INF/extended.xml" xpointer="xpointer(/idea-plugin/*)" />
    <extensions defaultExtensionNs="com.intellij">
        <lang.ast.factory language="Cangjie" implementationClass="com.huawei.idea.extend.cjpsi.adaptor.psi.CangjieASTFactory"/>
        <completion.contributor language="Cangjie" implementationClass="com.huawei.idea.completion.CangjieCompletionContributor"/>
        <lang.foldingBuilder language="Cangjie" implementationClass="com.huawei.idea.codefolding.CangJieFoldingBuilder"/>
        <lang.surroundDescriptor
                language="Cangjie"
                implementationClass="com.huawei.idea.surround.CangJieCustomFoldingSurroundDescriptor"/>
        <lang.braceMatcher language="Cangjie" implementationClass="com.huawei.idea.bracematcher.CangjieBraceMatcher"/>
        <enterHandlerDelegate implementation="com.huawei.idea.bracematcher.CangjieEnterAfterUnmatchedBraceHandler" order="first"/>
        <lang.commenter language="Cangjie" implementationClass="com.huawei.idea.formatter.CangjieCommenter"/>
        <projectService serviceImplementation="com.huawei.idea.lsp.launcher.CangjieLspPersistentComponent"/>-->
        <applicationService serviceImplementation="com.huawei.idea.lsp.listener.CangjieFileListenerRegisterSingleton"/>
        <breadcrumbsInfoProvider implementation="com.huawei.idea.breadcrumbs.CangjieBreadcrumbs"/>
        <lang.psiStructureViewFactory language="Cangjie" implementationClass="com.huawei.idea.structureview.CangjieStructureViewFactory"/>
        <postStartupActivity implementation="com.huawei.idea.lsp.launcher.PostSyncLspStartUp"/>
        <fileType name="Cangjie" language="Cangjie" implementationClass="com.huawei.idea.filetypes.CangjieCodeFile" fieldName="INSTANCE" extensions="cj"/>
        <fileType name="CangjieDeclaration" language="CangjieDeclaration" implementationClass="com.huawei.idea.filetypes.CangjieDeclarationFile" fieldName="INSTANCE" patterns="*.cj.d"/>
        <fileType name="CangjieMacrocall" language="CangjieMacrocall" implementationClass="com.huawei.idea.filetypes.CangjieMacroCallFileType" fieldName="INSTANCE" extensions="macrocall"/>
        <lang.parserDefinition language="Cangjie"  implementationClass="com.huawei.idea.language.CharParserDefinition"/>
        <lang.parserDefinition language="CangjieDeclaration"  implementationClass="com.huawei.idea.language.CangjieDeclarationParserDefinition"/>
        <lang.parserDefinition language="CangjieMacrocall"  implementationClass="com.huawei.idea.language.CangjieMacrocallParseDefinition"/>
        <enterHandlerDelegate implementation="com.huawei.idea.formatter.CangjieEnterHandlerDelegateAdapter"/>
        <backspaceHandlerDelegate implementation="com.huawei.idea.formatter.CangjieBackspaceHandlerDelegateAdapter"/>
        <!-- Char completion -->
        <typedHandler implementation="com.huawei.idea.edit.QuotePairCompletion" />
        <backspaceHandlerDelegate implementation="com.huawei.idea.edit.CangjieQuoteDeleteHandler" />
        <completion.contributor language="Cangjie" implementationClass="com.huawei.capabilities.completion.LSPCompletionContributor" order="first" id="lspCompletion4Cangjie"/>
        <typedHandler implementation="com.huawei.capabilities.completion.CangjieTypedHandler" />
        <!-- Char client semantic -->
        <highlightErrorFilter implementation="com.huawei.idea.highlightersetting.CharHighlightErrorFilter"/>
        <lang.syntaxHighlighterFactory language="Cangjie" implementationClass="com.huawei.idea.syntaxhighlighter.CangjieSyntaxFactory" />
        <lang.syntaxHighlighterFactory language="CangjieDeclaration" implementationClass="com.huawei.idea.syntaxhighlighter.CangjieSyntaxFactory" />
        <!-- SignatureHelp -->
        <codeInsight.parameterInfo language="Cangjie" implementationClass="com.huawei.idea.signaturehelp.CangjieSignatureHelp"/>
        <!-- Char server semantic -->
        <semanticHighlighter language="Cangjie" implementationClass="com.huawei.idea.highlightersetting.CangjieSemanticTokenHighlighter"/>
        <semanticHighlighter language="CangjieDeclaration" implementationClass="com.huawei.idea.highlightersetting.CangjieSemanticTokenHighlighter"/>
        <typeHierarchyProvider language="Cangjie" implementationClass="com.huawei.capabilities.typehierarchy.CangjieTypeHierarchyProvider"/>

        <!-- LSP extension point here below -->
        <!-- Suggestion -->
        <typedHandler implementation="com.huawei.capabilities.lsp.CangjieLSPTypedHandler" id="LSPTypedHandler"/>
        <usageTypeProvider implementation="com.huawei.idea.usage.CjReferenceUsageTypeProvider"/>
        <!-- Cangjie Rename -->
        <renameHandler implementation="com.huawei.capabilities.lsp.CangjieLSPRenameHandler"
                       id="LSPRenameHandler" order="first"/>
        <renamePsiElementProcessor implementation="com.huawei.capabilities.lsp.CangjieLSPRenameProcessor"
                                   id="LSPRenameProcessor" order="first"/>
        <lang.documentationProvider language="Cangjie" implementationClass="com.huawei.capabilities.lsp.CangjieDocumentationProvider"/>
        <!-- Goto Definition -->
        <gotoDeclarationHandler implementation="com.huawei.capabilities.lsp.CangjieGotoDeclarationHandler" id="LSPCangjieDeclarationContributor"/>
        <externalAnnotator language="Cangjie" implementationClass="com.huawei.idea.highlightersetting.CangjieSemanticHighlight" />
        <externalAnnotator language="CangjieDeclaration" implementationClass="com.huawei.idea.highlightersetting.CangjieSemanticHighlight" />
        <externalAnnotator language="Cangjie" implementationClass="com.huawei.idea.highlightersetting.CangjieExternalAnnotator" />
        <annotator language="" implementationClass="com.huawei.idea.highlightersetting.ModuleImportAnnotator" />
        <!-- Move File -->
        <moveFileHandler implementation="com.huawei.idea.refactor.move.CangjieMoveFileHandler"/>
        <colorSettingsPage implementation="com.huawei.idea.highlightersetting.CangjieColorSettingsPage"/>

        <lang.findUsagesProvider language="Cangjie" implementationClass="com.huawei.capabilities.lsp.CangjieFindUsagesProvider" />
        <fileStructureGroupRuleProvider implementation="com.huawei.idea.usage.rules.CangjieClassGroupRuleProvider"/>
        <fileStructureGroupRuleProvider implementation="com.huawei.idea.usage.rules.CangjieMethodGroupRuleProvider"/>
        <findUsagesHandlerFactory implementation="com.huawei.capabilities.lsp.CangjieFindUsagesHandlerFactory"/>
        <targetElementEvaluator language="Cangjie" implementationClass="com.huawei.capabilities.lsp.CangjieTargetElementEvaluatorEx2" />

        <callHierarchyProvider
                language="Cangjie" implementationClass="com.huawei.capabilities.hierarchy.callhierarchy.CangjieCallHierarchyProvider"/>

        <elementDescriptionProvider implementation="com.huawei.capabilities.lsp.CangjieElementDescriptionProvider" order="first"/>
        <refactoring.safeDeleteProcessor implementation="com.huawei.idea.refactor.CangjieFileSafeDeleteProcessorDelegate" order="first"/>
        <refactoring.safeDeleteProcessor implementation="com.huawei.idea.refactor.CangjieSafeDeleteProcessorDelegate" order="first"/>

        <lang.refactoringSupport language="Cangjie" implementationClass="com.huawei.idea.refactor.CangjieRefactoringSupportProvider"/>

        <notificationGroup displayType="STICKY_BALLOON" id="Cangjie.module.json.notification" isLogByDefault="true"/>
        <notificationGroup displayType="STICKY_BALLOON" id="Cangjie.lsp.notification" isLogByDefault="true"/>

        <psi.treeChangeListener implementation="com.huawei.idea.lsp.listener.ModuleJsonListener"/>

        <editorNotificationProvider implementation="com.huawei.idea.notification.CangjieEditorNotificationProvider"/>

        <editorHighlighterProvider filetype="Cangjie" implementationClass="com.huawei.idea.syntaxhighlighter.CangjieEditorHighlighterProvider" />
        <highlightingPassFactory  id="CangjieHighlightingPassFactory" order="last"
                                 implementation="com.huawei.idea.lsp.highlighting.CangjieLanguageServiceHighlightingPassFactory"/>
        <problemFileHighlightFilter id="CangjieProblemFileHighlightFilter"
                implementation="com.huawei.idea.lsp.highlighting.CangjieProblemFileHighlightFilter"/>

        <!--Resource Completion-->
        <completion.contributor language="Cangjie" implementationClass="com.huawei.idea.resource.CangjieResourceCompletionContributor"/>
        <!--App Resource Goto Definition-->
        <gotoDeclarationHandler implementationClass="com.huawei.idea.resource.CangjieResourceGotoDeclarationHandler"/>
        <!--Resource Reference-->
        <psi.referenceContributor implementation="com.huawei.idea.resource.CangjieResourceReferenceContributor"/>
        <!--APP Resource Diagnostic-->
        <localInspection language="Cangjie" shortName="CangjieResourceInspection"
                         displayName="Cangjie resource diagnostic"
                         groupName="Cangjie"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="com.huawei.idea.resource.CangjieResourceInspection"/>
        <!--RawFile Resource Reference-->
        <psi.referenceContributor implementation="com.huawei.idea.resource.CangjieRawFileReferenceContributor"/>
        <!--RawFile Resource Diagnostic-->
        <localInspection language="Cangjie" shortName="CangjieRawFileInspection"
                         displayName="Cangjie rawfile diagnostic"
                         groupName="Cangjie"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="com.huawei.idea.resource.CangjieRawFileInspection"/>
        <toolWindow
                id="Cangjie API"
                anchor="right"
                secondary="true"
                factoryClass="com.huawei.capabilities.apidocs.ApiDocsToolWindowFactory"
                order="last"
                canCloseContents="false"
                doNotActivateOnStart="true"
        />

        <codeInsight.overrideMethod language="Cangjie"
                                    implementationClass="com.huawei.idea.generation.override.CangjieOverrideMethodHandler"
        />

        <defaultLiveTemplates file="/liveTemplates/cangjie.xml"/>
        <liveTemplateContext implementation="com.huawei.idea.template.CangjieGeneric"
                             contextId="Cangjie"/>
        <liveTemplateContext
                contextId="Cangjie_COMPONENT"
                baseContextId="Cangjie"
                implementation="com.huawei.idea.template.CangjieComponentContext"/>

        <liveTemplateContext implementation="com.huawei.idea.template.CangjieDialogContext"
                             contextId="Cangjie_DIALOG" baseContextId="Cangjie"/>

        <liveTemplateContext implementation="com.huawei.idea.template.CangjieClassContext"
                             contextId="Cangjie_CLASS" baseContextId="Cangjie"/>

        <liveTemplateContext implementation="com.huawei.idea.template.CangjieClassFieldContext"
                             contextId="Cangjie_CLASS_FIELD" baseContextId="Cangjie"/>

        <renamePsiElementProcessor implementation="com.huawei.idea.rename.CangjieDirectoryRenameProcessor"
                                   id="CangjieDirectoryRenameProcessor" order="first"/>

        <applicationService
                serviceImplementation="com.huawei.idea.settings.CangjieLspSettings"/>
        <extendWordSelectionHandler implementation="com.huawei.idea.bracematcher.selection.CjBraceSelectionHandler"/>
        <basicWordSelectionFilter implementation="com.huawei.idea.bracematcher.selection.CjBraceSelectionHandlerFilter"/>
        <lang.foldingBuilder
                language="Cangjie"
                implementationClass="com.huawei.idea.codefolding.CangjieResourceFoldingBuilder"/>
        <lang.documentationProvider language="Cangjie" implementationClass="com.huawei.idea.resource.CangjieResourceDocProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.huawei.ace.refactor">
        <fileOrDirectoryMoveChecker implementation="com.huawei.idea.refactor.move.CangjieMoveChecker"> </fileOrDirectoryMoveChecker>
    </extensions>

    <extensions defaultExtensionNs="com.huawei.ace.lsp.extensions.client">
        <CrossLanguageGotoImplementationProvider implementation="com.huawei.capabilities.crosslanguage.CangjieCrossGotoImplementationProvider"> </CrossLanguageGotoImplementationProvider>
        <CrossLanguageRenameProvider implementation="com.huawei.capabilities.crosslanguage.CangjieCrossRenameProvider"> </CrossLanguageRenameProvider>
    </extensions>

    <extensions defaultExtensionNs="com.huawei.ace.crosslanguage">
        <crossLanguageDiagnosticProvider implementation="com.huawei.capabilities.crosslanguage.diagnostic.CangjieCrossLanguageDiagnosticProvider"> </crossLanguageDiagnosticProvider>
    </extensions>

    <extensions defaultExtensionNs="com.huawei.deveco.build">
        <compileBuildListener implementation="com.huawei.idea.lsp.launcher.CangjieCompileBuildListener"> </compileBuildListener>
    </extensions>

    <extensions defaultExtensionNs="com.huawei.ace.refactor.rename">
        <fileOrDirectoryRenameChecker implementation="com.huawei.idea.rename.CangjieDirectoryRenameChecker"> </fileOrDirectoryRenameChecker>
    </extensions>

    <extensions defaultExtensionNs="com.huawei.cangjie">
        <settingProvider id="CangjieLspConfig" implementation="com.huawei.idea.settings.CangjieLspConfigurable"/>
    </extensions>

    <application-components>
    </application-components>

    <actions>
        <unregister id="GotoImplementation"/>
        <action id="CangJieGotoImplementation" text="Implementation(s)"
                class="com.huawei.capabilities.lsp.CangjieGotoImplementationAction" >
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt B"/>
            <add-to-group group-id="EditorPopupMenu.GoTo" anchor="after" relative-to-action="GotoImplementation" />
        </action>

        <unregister id="OverrideMethods"/>
        <action id="OverrideMethods" text="Override Methods…"
                class="com.huawei.idea.generation.override.CangjieOverrideMethodsAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl O"/>
            <add-to-group group-id="GenerateGroup" anchor="before" relative-to-action="ImplementMethods" />
        </action>

        <group id="CangjieGoToCodeGroup">
            <action id="GotoImplementation" text="Implementation(s)"
                    description="Navigate to the declaration of the symbol at caret or show its usages"
                    class="com.huawei.capabilities.lsp.ExtendArkUiGotoImplementationAction">
                <add-to-group group-id="EditorPopupMenu.GoTo" anchor="before" relative-to-action="GotoTest"/>
            </action>
        </group>

        <action id="CharPlugin.NewCangJieFileAction" class="com.huawei.idea.actions.CangjieNewFileAction" text="Cangjie File"
                description="Create new Cangjie code file in the current project" icon="/icons/Cangjie_logo_icon.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </action>
        <action id="CangjieExtractVariable"
                class="com.huawei.idea.refactor.actions.ExtractVariableAction"
                text="Extract Variable">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt V"/>
            <add-to-group group-id="IntroduceActionsGroup" anchor="before" relative-to-action="ExtractMethod"/>
        </action>
        <action id="CangjieExtractInterface"
                class="com.huawei.idea.refactor.actions.ExtractInterfaceAction"
                text="Extract Interface"
                description="Extract interface from class or struct">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt I"/>
            <add-to-group group-id="IntroduceActionsGroup" anchor="after" relative-to-action="ExtractMethod"/>
        </action>
        <action id="CangjieExtractResource"
                class="com.huawei.idea.refactor.actions.ExtractResourceAction"
                text="Extract Resource">
            <add-to-group group-id="IntroduceActionsGroup" anchor="after" relative-to-action="CangjieExtractInterface"/>
        </action>
        <action id="CangjieInLineVariable"
                class="com.huawei.idea.refactor.actions.InLineVariableAction"
                text="Inline Variable">
            <add-to-group group-id="RefactoringMenu" anchor="after" relative-to-action="Inline"/>
        </action>
        <action id="CangjieInLineMethod"
                class="com.huawei.idea.refactor.actions.InLineMethodAction"
                text="Inline Method">
            <add-to-group group-id="RefactoringMenu" anchor="after" relative-to-action="CangjieInLineVariable"/>
        </action>
        <action id="CangjieIntroduceConst"
                class="com.huawei.idea.refactor.actions.IntroduceConstAction"
                text="Introduce Constant"
                description="Introduce const">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
            <add-to-group group-id="RefactoringMenu" anchor="before" relative-to-action="IntroduceConstant"/>
        </action>
        <action id="CangjieIntroduceField"
                class="com.huawei.idea.refactor.actions.IntroduceFieldAction"
                text="Introduce Field"
                description="Introduce selected Cangjie expression to a field">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F"/>
            <add-to-group group-id="RefactoringMenu" anchor="after" relative-to-action="CangjieIntroduceConst"/>
        </action>
        <action id="CangjieIntroduceParameter"
                class="com.huawei.idea.refactor.actions.IntroduceParameterAction"
                text="Introduce Parameter"
                description="Extract selected Cangjie expression to a function paramter">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P"/>
            <add-to-group group-id="RefactoringMenu" anchor="after" relative-to-action="CangjieIntroduceField"/>
        </action>
        <unregister id="ArkUiCreateResourceDialog"/>
        <action class="com.huawei.idea.refactor.actions.ExtendArkUiRefactorResourceAction"
                id="ArkUiCreateResourceDialog" text="Extract Resource">
            <add-to-group group-id="RefactoringMenu" anchor="after" relative-to-action="ReformatCode"/>
        </action>
    </actions>
    <applicationListeners>
        <listener class="com.huawei.idea.lsp.listener.TomlRegistrarListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener" />
    </applicationListeners>
</idea-plugin>

package ohos_app_cangjie_entry.graphqls.noj.operation.question

internal import encoding.json.*
internal import serialization.serialization.*
internal import std.collection.*

internal import ohos_app_cangjie_entry.apollo.api.*
import ohos_app_cangjie_entry.apollo.macros.*

@GqlOperation
public class AdvertisementAdsQuery <: Query<AdvertisementAdsQuery_Data> {
    // common
    public let OPERATION_ID: String = "" // TODO: may be som hash code generated by Apollo
    public let OPERATION_NAME: String = "advertisementAds"
    public let OPERATION_DOCUMENT: String = """
    query advertisementAds($pageSlug: String!){
       advertisementAdsByPage(pageSlug: $pageSlug, terminalName: "APP - HarmonyOS") {
          ads {
            __typename
            ... on AdvertisementItemNode {
              image
              isTagShown
              link
              name
              title
            }
          }
           position {
               nameSlug
           }
        }
    }"""

    // variables
    public AdvertisementAdsQuery(
        public var pageSlug: String
    ) {}
}

@GqlSerialize
public class AdvertisementAdsQuery_Data <: OperationData {
    public AdvertisementAdsQuery_Data(
        public let advertisementAdsByPage: ?ArrayList<AdvertisementAdsQuery_AdvertisementAdsByPage>
    ){}
}

@GqlSerialize
public class AdvertisementAdsQuery_AdvertisementAdsByPage {
    public AdvertisementAdsQuery_AdvertisementAdsByPage(
        public let ads: ArrayList<AdvertisementAdsQuery_Ad>,
        public let position: AdvertisementAdsQuery_Position
    ){}
}

@GqlSerialize
public class AdvertisementAdsQuery_Ad {
    public AdvertisementAdsQuery_Ad(
        public let __typename: String,
        @IsFragment
        public let onAdvertisementItemNode: ?AdvertisementAdsQuery_OnAdvertisementItemNode
    ){}
}

@GqlFragment
@GqlSerialize
public class AdvertisementAdsQuery_OnAdvertisementItemNode {
    public AdvertisementAdsQuery_OnAdvertisementItemNode(
        public let image: String,
        public let isTagShown: Bool,
        public let link: String,
        public let name: String,
        public let title: String
    ){}
}

@GqlSerialize
public class AdvertisementAdsQuery_Position {
    public AdvertisementAdsQuery_Position(
        public let nameSlug: String
    ){}
}


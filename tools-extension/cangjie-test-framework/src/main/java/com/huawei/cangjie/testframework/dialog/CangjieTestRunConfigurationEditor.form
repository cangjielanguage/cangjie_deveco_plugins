<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.huawei.cangjie.testframework.dialog.CangjieTestRunConfigurationEditor">
  <grid id="27dc6" binding="myPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="630" height="420"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="b9545" class="com.intellij.ui.components.JBTabbedPane" binding="mJBTabbedPane">
        <constraints border-constraint="Center"/>
        <properties>
          <visible value="true"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="af139" layout-manager="GridLayoutManager" row-count="7" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title-resource-bundle="message/OhosPanelBundle" title-key="ohosTest.run.configuration.general.tab.title"/>
            </constraints>
            <properties>
              <visible value="true"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="fa513" class="com.intellij.ui.components.JBLabel" binding="myModuleJBLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <labelFor value="e32ab"/>
                  <text value="&amp;Module:"/>
                </properties>
              </component>
              <vspacer id="17ea0">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                </constraints>
              </vspacer>
              <component id="27569" class="com.huawei.deveco.ohos.debugcommon.module.ModuleModelComboBox" binding="myModulesComboBox">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <grid id="585fa" binding="myConfigurationSpecificPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="4" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <hspacer id="64505">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
              </hspacer>
            </children>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>

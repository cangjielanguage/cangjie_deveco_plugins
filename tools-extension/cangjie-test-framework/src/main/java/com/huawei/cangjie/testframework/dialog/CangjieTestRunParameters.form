<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.huawei.cangjie.testframework.dialog.CangjieTestRunParameters">
  <grid id="27dc6" binding="myPanel" layout-manager="GridLayoutManager" row-count="9" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="742" height="415"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="1ed75" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Test Type:"/>
        </properties>
      </component>
      <component id="12176" class="javax.swing.JRadioButton" binding="packageButton">
        <constraints>
          <grid row="1" column="1" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <actionCommand resource-bundle="message/OhosPanelBundle" key="ohosTest.configuration.all.tests.in.package.radio"/>
          <text value="All in Package"/>
        </properties>
      </component>
      <component id="8a07b" class="com.intellij.ui.components.JBLabel">
        <constraints>
          <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <horizontalAlignment value="2"/>
          <horizontalTextPosition value="2"/>
          <iconTextGap value="4"/>
          <text resource-bundle="message/OhosPanelBundle" key="ohosTest.configuration.configure.test.label"/>
        </properties>
      </component>
      <component id="5b2a1" class="com.intellij.openapi.ui.LabeledComponent" binding="packageComponent">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="javax.swing.JPanel"/>
          <labelLocation value="West"/>
          <text value="Package"/>
        </properties>
      </component>
      <component id="bb532" class="com.intellij.openapi.ui.LabeledComponent" binding="fileComponent">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="javax.swing.JPanel"/>
          <labelLocation value="West"/>
          <text value="Test file"/>
        </properties>
      </component>
      <grid id="f6e4a" binding="parametersPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none" title="Parameters"/>
        <children>
          <component id="a99d3" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Time Out(s):"/>
            </properties>
          </component>
          <component id="2c2c5" class="javax.swing.JTextField" binding="timeout">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <component id="b753b" class="javax.swing.JRadioButton" default-binding="true">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <selected value="true"/>
          <text value="Cangjie"/>
        </properties>
      </component>
      <component id="b27fb" class="javax.swing.JRadioButton" binding="fileRadioButton">
        <constraints>
          <grid row="1" column="2" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <actionCommand resource-bundle="message/OhosPanelBundle" key="ohosTest.configuration.all.tests.in.package.radio"/>
          <text value="Test file"/>
        </properties>
      </component>
      <component id="ac8b8" class="javax.swing.JRadioButton" binding="classRadioButton">
        <constraints>
          <grid row="1" column="3" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <actionCommand resource-bundle="message/OhosPanelBundle" key="ohosTest.configuration.test.method.radio"/>
          <selected value="false"/>
          <text value="Class"/>
        </properties>
      </component>
      <component id="f577b" class="javax.swing.JRadioButton" binding="methodRadioButton">
        <constraints>
          <grid row="1" column="4" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <actionCommand resource-bundle="message/OhosPanelBundle" key="ohosTest.configuration.test.method.radio"/>
          <selected value="false"/>
          <text value="Method"/>
        </properties>
      </component>
      <grid id="ed018" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="5" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d0538" class="com.huawei.deveco.ohos.testframework.run.editor.dialog.TestArgsComponent" binding="testArgsComponent">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelLocation value="West"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="4096e" class="com.intellij.openapi.ui.LabeledComponent" binding="classSelected">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="javax.swing.JPanel"/>
          <labelLocation value="West"/>
          <text value="Class name"/>
        </properties>
      </component>
      <component id="63793" class="com.intellij.openapi.ui.LabeledComponent" binding="methodSelected">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="javax.swing.JPanel"/>
          <labelLocation value="West"/>
          <text value="Method name"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
